# Copy values into a local secret store or process environment. Never commit real values.
PONKUN_HUB_URL=http://127.0.0.1:8788
PONKUN_MOBILE_HUB_URL=http://127.0.0.1:8788
PONKUN_INFERENCE_BACKEND=strata
PONKUN_STRATA_URL=http://127.0.0.1:47831
PONKUN_TTS_BACKEND=legacy_local
PONKUN_TTS_PROXY_URL=http://127.0.0.1:8000
PONKUN_TTS_MODEL=s2-pro
PONKUN_TTS_REFERENCE_ID=replace-with-your-own-reference-id
PONKUN_TTS_FORMAT=mp3
PONKUN_PYTHON=
PONKUN_PYTHONW=
PONKUN_MOBILE_REMOTE_URL=

# Supply these through Windows Credential Manager or another secret store.
PONKUN_HUB_CLIENT_TOKEN=
PONKUN_MOBILE_AUTH_TOKEN=
PONKUN_STRATA_API_KEY=
OPENAI_API_KEY=

# Fish Audio uses a host file outside this repository, mounted as a Docker secret.
FISH_AUDIO_API_KEY_SECRET_FILE=C:\path\outside\the-repository\fish_audio_api_key

# Live integrations remain disabled in development and CI.
PONKUN_RUN_LIVE_INTEGRATION=0
PONKUN_RUN_VOICE_BENCHMARK=0

